{
  "name": "onetool",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "check": "pnpm run build && pnpm run test && pnpm run quality",
    "quality": "codopsy-ts analyze ./packages --no-color --no-degradation"
  },
  "devDependencies": {
    "@o6lvl4/onetool-core": "workspace:*",
    "codopsy-ts": "1.4.0"
  }
}
