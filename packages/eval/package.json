{
  "name": "@o6lvl4/onetool-eval",
  "version": "0.0.0",
  "private": true,
  "description": "Measures whether a model works better with onetool's four generic tools or with one tool per operation. Not published.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
